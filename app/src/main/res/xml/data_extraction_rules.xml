<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+. The feedback-protection bypass lives in its own
   DataStore file so it is never restored onto another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/safety.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/safety.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
