<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+.
   All backups and device transfers are disabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
